#: mood/server/__main__.py:262
msgid ""
"Commands:\n"
"                            help - you're here\n"
"                            up \\ down \\ left \\ right — movement\n"
"                            attack <name> [with <weapon>] — attack "
"monster\n"
"                            addmon <name> hello <message> hp <hp> coords "
"<x> <y> — add monster\n"
"                            sayall <string> — (use brackets if not one "
"word)\n"
"                            quit — leave the dungeon\n"
msgstr ""
"Команды:\n"
"                        help — вы здесь\n"
"                        up \\ down \\ left \\ right — движения по данжу\n"
"                        attack <name> [with <weapon>] — атаковать монстра\n"
"                        addmon — добавить монстра\n"
"sayall — <строка> (либо одно слово, либо строка в кавычках)\n"
"                        quit — выбраться из подземелья\n"

#: mood/server/__main__.py:273
msgid ""
"Unknown command.                                Enter 'help' for command "
"list.\n"
msgstr ""
"Неизвестная команда.                                Введите 'help' для "
"списка команд.\n"

